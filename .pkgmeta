package-as: EvokerAug
enable-nolib-creation: no

ignore:
  - tests
  - scripts
  - .github
  - .gitignore
  - .pytest_cache
  - backups
  - AGENTS.md
  - AUDIT.md
  - PLAN.md
  - NOTES.md
  - TODO.md
  - CLAUDE.md
  - "*.private.md"
  - "*.private/"
  - Libs/LibCustomGlow-1.0/.editorconfig
  - Libs/LibCustomGlow-1.0/.luarc.json
  - Libs/LibCustomGlow-1.0/.pkgmeta
  - Libs/LibCustomGlow-1.0/cspell.json
  - Libs/AceGUI-3.0-SharedMediaWidgets/Libs

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
